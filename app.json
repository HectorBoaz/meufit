{
  "expo": {
    "name": "Maiza Fit",
    "slug": "maizafit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "maizafit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.hectorboaz.meufit",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hectorboaz.meufit"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E0457B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
